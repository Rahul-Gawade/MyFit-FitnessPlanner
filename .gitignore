# ========================
# Root / Monorepo .gitignore
# ========================

# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build output
client/dist/
server/dist/
server/build/

# Environment variables (NEVER commit these)
.env
.env.local
.env.*.local
client/.env
client/.env.local
server/.env
server/.env.local

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Debug / temp files
test_api.js
*.local
